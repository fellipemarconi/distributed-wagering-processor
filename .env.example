PORT=3000
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_LOCK_TIMEOUT_MS=5000
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=wager-transactions.fifo

# Publisher da outbox (ligue em pelo menos uma instância)
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=10
OUTBOX_PUBLISH_TIMEOUT_MS=2000
OUTBOX_QUEUE_NAME=wagering-events.fifo

LOG_LEVEL=log

# Usado apenas pelos testes (bun test)
TEST_DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering_test


POSTGRES_PORT=5432
LOCALSTACK_PORT=4566
