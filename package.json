{
  "name": "distributed-wagering-processor",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "SKIP_INFRA=1 bun test test/domain",
    "test:integration": "docker compose up -d --wait && bun test",
    "test:load": "docker compose up -d --wait && bun test/load.ts",
    "migration:create": "bun --bun mikro-orm migration:create --blank",
    "migration:up": "bun --bun mikro-orm migration:up",
    "migration:down": "bun --bun mikro-orm migration:down"
  },
  "mikro-orm": {
    "configPaths": ["./src/mikro-orm.config.ts"]
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1146.0",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/nestjs": "^6",
    "@mikro-orm/postgresql": "^6",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "decimal.js": "^10.6.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6",
    "@nestjs/testing": "^11",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
